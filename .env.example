# Password for the single human owner (required). Use a long random one, e.g. `openssl rand -base64 18`.
OWNER_PASSWORD=change-me

# Public URL of this site; used in links returned to agents. Use the https:// address in production.
PUBLIC_URL=http://localhost:3000

# Time zone for day grouping and date filters.
# TZ=Asia/Shanghai

# Optional. Defaults shown.
# PORT=3000
# DATA_DIR=./data
# SESSION_SECRET=   # generated and stored in the database if unset
# TRUST_PROXY=1     # set when behind a reverse proxy that sets X-Forwarded-For (compose.prod.yml does)

# Production with compose.prod.yml: the domain Caddy serves and gets a certificate for.
# DOMAIN=reports.example.com
